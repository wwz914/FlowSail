{
  "name": "flowsail",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "FlowSail —— 可嵌入 React 应用的工作流画布编辑器内核（pnpm monorepo）",
  "license": "MIT",
  "packageManager": "pnpm@10.23.0",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "pnpm build:libs && pnpm --filter example dev",
    "build": "pnpm build:libs && pnpm --filter example build",
    "build:libs": "pnpm --filter @flowsail/core build && pnpm --filter @flowsail/react build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "typecheck": "pnpm build:libs && tsc -b packages/example/tsconfig.json",
    "check:size": "node scripts/check-size.mjs",
    "check:links": "node scripts/check-links.mjs",
    "check:pack": "node scripts/smoke-pack.mjs",
    "release:github": "node scripts/release-github.mjs",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "pnpm build:libs && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^9.39.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^5.1.0",
    "autoprefixer": "^10.4.22",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^30.1.3",
    "playwright": "^1.64.1",
    "postcss": "^8.5.6",
    "postcss-nested": "^7.0.2",
    "sass-embedded": "^1.93.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "zustand": "^5.0.9"
  }
}
