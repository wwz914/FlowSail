{
  "name": "@flowsail/react",
  "version": "0.2.1",
  "description": "FlowSail 的可嵌入 React 工作流画布编辑器",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "keywords": [
    "workflow",
    "editor",
    "flow",
    "react",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wwz914/FlowSail.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/wwz914/FlowSail#readme",
  "bugs": {
    "url": "https://github.com/wwz914/FlowSail/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "test": "vitest run --config ../../vitest.config.ts packages/react"
  },
  "dependencies": {
    "@flowsail/core": "workspace:*",
    "zustand": "^5.0.9"
  },
  "peerDependencies": {
    "react": ">=18 <20",
    "react-dom": ">=18 <20"
  },
  "devDependencies": {
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "sass-embedded": "^1.93.3",
    "typescript": "^5.9.3",
    "vite": "^7.2.4",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@10.23.0"
}
